---
/**
 * La portada (`/`): el Hero limpio con efecto cristal sobre el mapeo
 * desenfocado, seguido inmediatamente del mural interactivo y de las
 * secciones que lo explican.
 *
 * El relato de donde sale la figura —la visualizacion de datos, el mito de
 * Quetzalcoatl y la dieta de la milpa— se mudo a `/historia`
 * (`src/pages/historia.astro`); aqui entra por la seccion «La historia de
 * nuestros símbolos», que es su puerta. Asi la portada abre con el mural y no
 * con media docena de pantallas de lectura.
 *
 * El `<script>` de abajo lo bundlea Astro con Vite y corre solo en el
 * navegador, asi que el motor de acuarela nunca se ejecuta en el build.
 */
import Base from '../layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import '../styles/app.css';
import { REFERENCIAS, citaPlana } from '../data/referencias';
import { PLANTILLA_DIBUJO } from '../io/plantilla';

const BASE = import.meta.env.BASE_URL;

/** Una pieza de la mesa: la imagen y lo que va escrito debajo de ella. */
interface ConceptoPieza {
  /** Ruta dentro de `public/Conceptos/`, o `null` si la imagen de esa pieza
   *  todavia no existe: entonces la galeria pinta el hueco gris. */
  archivo: string | null;
  ancho: number;
  alto: number;
  titulo: string;
  pie: string;
  /** El alternativo de la foto. Las piezas pendientes no lo llevan: un hueco
   *  gris no tiene nada que describirle a quien no ve la pagina. */
  alt?: string;
}

interface ConceptoGrupo {
  titulo: string;
  bajada: string;
  piezas: ConceptoPieza[];
}

/** La mesa de referencias de `#concepto`: cada grupo es una carpeta de
 *  `public/Conceptos/` y el orden de aqui es el que sale en la pagina —el
 *  tema (la milpa), la herramienta (la visualizacion) y la forma (los
 *  antepasados).
 *
 *  Para cambiar una imagen basta con dejar el archivo nuevo en su carpeta y
 *  corregir `archivo`, `alto`/`ancho` (van en el `<img>` para que el hueco
 *  quede reservado antes de que baje la foto) y los textos.
 *
 *  Las piezas de `Visualización de datos` van con `archivo: null`: ahi no hay
 *  imagen propia todavia, asi que en su lugar queda un hueco gris con la
 *  proporcion que va a tener la obra. Para estrenarla, el archivo en su
 *  carpeta, la ruta en `archivo` y su `alt`. */
const CONCEPTO_GRUPOS: ConceptoGrupo[] = [
  {
    titulo: 'Dieta de la milpa · Comercio en la etapa de los mexicas',
    bajada:
      'La dieta de la milpa se ha mantenido en nuestra cultura de manera intacta desde hace ' +
      'décadas; sigue vigente en muchas comunidades rurales de nuestro territorio, que la ' +
      'llevan adelante.',
    piezas: [
      {
        archivo: 'Dieta_Milpa/dieta.webp',
        ancho: 1500,
        alto: 2000,
        titulo: 'Museo Nacional de Antropología e Historia',
        pie:
          'Maqueta del mercado de Tlatelolco en el Museo Nacional de Antropología, Sala Mexica. ' +
          'En ella está la milpa repartida: maíz, calabaza, chile y nopal.',
        alt:
          'Maqueta del mercado prehispánico de Tlatelolco: decenas de figuras de barro entre ' +
          'hileras de verdura, chile y calabaza tendidas en petates.',
      },
      {
        archivo: 'Dieta_Milpa/dieta_uno.webp',
        ancho: 1500,
        alto: 2000,
        titulo: 'Museo Nacional de Antropología e Historia',
        pie:
          'El mismo mercado. Queríamos mostrar la importancia de la milpa y que, en efecto, ha ' +
          'sido necesaria desde hace miles de años.',
        alt:
          'Detalle de la maqueta del mercado: puestos con canastos, costales y montones de ' +
          'semilla sobre petates.',
      },
    ],
  },
  {
    titulo: 'Visualización de datos · El mito de Quetzalcóatl',
    bajada:
      'Usamos de referencia los network graphs, asimilando los astros que pudieron ser ' +
      'estudiados gracias a la misma ciencia que nos dejó Quetzalcóatl.',
    piezas: [
      {
        archivo: null,
        ancho: 1100,
        alto: 1040,
        titulo: 'La red de testimonios',
        pie:
          'La visualización de datos también hace referencia a esa ciencia que nos dejó, ' +
          'pudiendo utilizarla para alzar la voz mediante esta herramienta.',
      },
      {
        archivo: null,
        ancho: 1100,
        alto: 995,
        titulo: 'Uso de espirales',
        pie:
          'El uso de formas en espiral hace referencia a todo este ciclo en la vida, el mismo ' +
          'que utilizaban anteriormente nuestras culturas del México antiguo.',
      },
      {
        archivo: null,
        ancho: 696,
        alto: 1000,
        titulo: 'Color del mural',
        pie:
          'El rojo se escogió porque somos la sangre de Quetzalcóatl: de él venimos, él es el ' +
          'protector de nuestro pueblo.',
      },
    ],
  },
  {
    titulo: 'Inspiración de nuestros antepasados',
    bajada:
      'De dónde viene la forma: los códices y las piedras labradas.',
    piezas: [
      {
        archivo: 'Inspiracion_antepasados/codice.webp',
        ancho: 2000,
        alto: 1125,
        titulo: 'Códices · Sala Mexica',
        pie:
          'Se buscó replicar en esta obra una asimilación de los códices que hacían hace años ' +
          'nuestros predecesores.',
        alt: 'Vitrina de museo con dos códices desplegados en biombo, vistos por encima.',
      },
      {
        archivo: 'Inspiracion_antepasados/inspo.webp',
        ancho: 1500,
        alto: 2000,
        titulo: 'Piedras labradas · Sala Mexica',
        pie:
          'Nos inspiramos en todas estas obras ubicadas en el Museo Nacional de Antropología e ' +
          'Historia.',
        alt: 'Monolito de basalto con relieves tallados en la base y en el cuerpo de la piedra.',
      },
      {
        archivo: 'Inspiracion_antepasados/codice_uno.webp',
        ancho: 2000,
        alto: 1125,
        titulo: 'Códices',
        pie:
          'Los trazos irregulares dentro de todos estos códices fueron inspiración clave en el ' +
          'desarrollo de la pieza.',
        alt:
          'Página de códice con escenas pintadas dentro de casillas separadas por líneas rojas.',
      },
      {
        archivo: 'Inspiracion_antepasados/inspo_uno.webp',
        ancho: 1500,
        alto: 2000,
        titulo: 'Inspiración en los ornamentos',
        pie:
          'Nos guiamos en todas esas formas, en todo ese aspecto adornado en cada pieza.',
        alt:
          'Dos lápidas de basalto con felinos tallados de perfil, montadas sobre un muro rosa de museo.',
      },
      {
        archivo: 'Inspiracion_antepasados/inspo_dos.webp',
        ancho: 1500,
        alto: 2000,
        titulo: 'Piedra',
        pie:
          'Los ornamentos que acompañan a Quetzalcóatl vienen de todas estas piezas que ' +
          'dejaron nuestros antepasados.',
        alt:
          'Detalle del relieve en piedra: figuras con el tocado de plumas abierto en abanico, ' +
          'repetidas una junto a otra.',
      },
      {
        archivo: 'Inspiracion_antepasados/codice_dos.webp',
        ancho: 2000,
        alto: 1125,
        titulo: 'Rojo, ocre y azul sobre crema',
        pie:
          'La paleta de la que sale la nuestra: el rojo de la cochinilla, el ocre de la tierra y ' +
          'el azul, siempre sobre el fondo crema del papel.',
        alt:
          'Detalle de un códice con figuras y grecas pintadas en rojo, ocre y azul sobre fondo crema.',
      },
    ],
  },
];

/** Los datos estructurados de `#referencias`, armados de `REFERENCIAS` para que
 *  no haya una segunda copia de las citas que se pueda desfasar: los articulos
 *  salen como `ScholarlyArticle` y el documento de la Secretaria de Salud como
 *  `WebPage`.
 *
 *  Cuando el articulo tiene pagina propia, `url` apunta ahi y el DOI va en
 *  `sameAs`; cuando el DOI es el unico enlace, es el que ocupa `url`. */
const REFERENCIAS_JSONLD = {
  '@context': 'https://schema.org',
  '@graph': REFERENCIAS.map((ref) => {
    const e = ref.esquema;
    const esDoi = ref.url?.startsWith('https://doi.org/') ?? false;
    // La investigacion propia no tiene direccion fuera del sitio: va sin `url`.
    const enlace = ref.pagina ?? ref.url;
    return {
      '@type': e.tipo,
      name: e.nombre,
      author: e.autores.map((nombre) => ({
        '@type': e.institucional ? 'Organization' : 'Person',
        name: nombre,
      })),
      ...(e.colaboradores
        ? {
            contributor: e.colaboradores.map((nombre) => ({ '@type': 'Person', name: nombre })),
          }
        : {}),
      datePublished: e.fecha,
      isPartOf: {
        '@type': e.tipo === 'ScholarlyArticle' ? 'Periodical' : 'WebSite',
        name: e.parteDe,
      },
      ...(e.lugar ? { contentLocation: { '@type': 'Place', name: e.lugar } } : {}),
      ...(enlace ? { url: enlace } : {}),
      ...(ref.pagina && esDoi ? { sameAs: ref.url } : {}),
    };
  }),
};
---

<Base
  title="Mural de Acuarela · Cartografía Emocional Colectiva"
  description="Mural de acuarela interactivo sobre la dieta de la milpa y la violencia alimentaria estructurada. Proyecto independiente de Daniel Capistran, con dirección visual de Syle Studio."
  bodyClass="bg-[#f9f6f0]"
>
  <Nav pagina="inicio" />

  <main>
    <!-- ================================================ Hero con efecto Glass -->
    <section
      id="inicio"
      class="relative -mt-[60px] flex min-h-[100dvh] items-center justify-center overflow-hidden bg-[#fcfaf5] px-6 pt-[calc(60px+4rem)] pb-16 telefono:px-4 telefono:pt-[calc(60px+3rem)] telefono:pb-12"
    >
      <!-- Capa 1: El mapeo real de fondo (dibujo + manchas de acuarela) -->
      <div
        id="hero-bg"
        aria-hidden="true"
        class="hero-exit-target pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden select-none"
      >
        <div class="absolute -top-24 -left-24 h-[420px] w-[420px] rounded-full bg-[#b23a48]/12 blur-[90px]"></div>
        <div class="absolute top-1/3 -right-24 h-[440px] w-[440px] rounded-full bg-[#3e8e8a]/12 blur-[95px]"></div>
        <div class="absolute -bottom-24 left-1/4 h-[380px] w-[380px] rounded-full bg-[#d9a441]/15 blur-[85px]"></div>

        <div class="relative flex h-[min(96vw,86dvh)] w-[min(96vw,86dvh)] items-center justify-center scale-105 md:scale-115">
          <img
            src={PLANTILLA_DIBUJO}
            alt=""
            class="hero-lamina absolute inset-0 h-full w-full object-contain opacity-60"
          />
          <canvas
            id="hero-canvas"
            class="hero-lamina relative h-full w-full object-contain opacity-0 transition-opacity duration-500"
          ></canvas>
        </div>
      </div>

      <!-- Capa 2: Cristal esmerilado sobre todo el Hero desenfocando el mapeo -->
      <div aria-hidden="true" class="glass-hero-veil pointer-events-none absolute inset-0"></div>

      <!-- Capa 3: Solo el titulo y el texto debajo, limpio sin recuadros -->
      <div id="hero-content" class="hero-exit-target relative z-10 mx-auto max-w-[820px] text-center">
        <h1 class="hero-title mx-auto max-w-[780px] text-[42px] font-mid leading-[1.12] tracking-[-0.02em] md:text-[52px] telefono:text-[30px]">
          Los dioses siguen cuidando a sus hijos a través de su fruto
        </h1>

        <p class="mx-auto mt-5 max-w-[660px] text-lg leading-[1.65] text-ink/85 md:text-xl telefono:text-base">
          Una obra donde cada persona tiene algo que decir, todo un pueblo que se siente lastimado y necesita volver a conectar con su tierra
          todo expresado mediante un lienzo. Al encontrarse aqui, el pueblo habla y se
          funde con sus raices y revelan el pulso vivo de quienes aun mantienen lo que por derecho les pertenece.
        </p>
      </div>

      <!-- Capa 4: Pista de la interaccion (cualquier gesto baja al mural) -->
      <div
        id="hero-hint"
        class="pointer-events-none absolute bottom-7 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1.5 text-muted telefono:bottom-5"
      >
        <span class="text-xs font-mid tracking-[0.12em] uppercase">Desliza o toca para ver el mural</span>
        <svg class="hero-hint-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>
    </section>

    <!-- ======================================== 01 · El Mural Interactivo -->
    <!-- A sangre y del alto de la pantalla, sin encabezado ni recuadro: el
         lienzo es la seccion entera. Las entradas a los paneles siguen siendo
         los iconos al pie del propio mural y el boton de la barra. -->
    <section id="mural" class="h-[calc(100dvh-60px)] scroll-mt-[60px]">
      <!-- Aqui monta `src/mural/main.ts` el `.kiosk` intacto -->
      <div id="mural-mount" class="h-full"></div>
    </section>

    <!-- ====================================== 02 · La escala de la alimentación -->
    <!-- Las secciones de abajo son texto corrido: sin tarjetas ni recuadros,
         el orden es el del argumento. Primero por qué existe la pieza, luego
         de dónde sale su figura —eso es `/historia`, y aquí entra por la
         seccion que la anuncia— y después cómo se armó todo (el concepto). La
         única excepción es la última, «Cómo participar»: ahí las preguntas sí
         van en tarjetas que se despliegan.

         Las nueve muestras de la escala iban aquí, debajo del texto. Se
         fueron a «Visualización de datos» (`historia.astro`), que es donde se
         explica la herramienta con la que se mide: la escala es el
         instrumento, no el significado. El `id` de la seccion sigue siendo
         `escala` porque es el del mapa del sitio y el del pie. -->
    <section id="escala" class="relative isolate scroll-mt-[60px] border-t border-[#7d1f22] bg-[#9e2b2b] py-20 px-5 telefono:py-12 telefono:px-3.5">
      <!-- El fondo de red, con el andamio de tres capas: recorte al ras de
           la seccion, riel con una pantalla de holgura por lado —para que la
           escena este pegada desde antes de que la seccion llegue arriba— y
           la escena pegada bajo la barra. El mismo andamio esta en
           «Visualización de datos», que se fue a `/historia` con su propio
           lienzo: lo arma el mismo codigo (`pintarFondoDatos()` en
           `src/mural/pagina.ts`) y cada ruta aporta el lienzo que tiene.

           Va en `-z-10` dentro de la seccion, que es contexto de apilamiento
           (`isolate`): asi queda encima del carmin y debajo del texto.

           Sobre el carmin el lienzo no se funde como arriba sino que aclara
           (`mix-blend-screen`), y antes de mezclarse se le va el color y se
           le sube el brillo. Es el mismo pigmento del mural —una acuarela
           rosada que en la crema se lee tenue—, pero aqui pasa a blanco y la
           red se ve de verdad sobre el rojo. Sin esto quedaba un rosa apenas
           mas claro que el fondo. -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-clip select-none">
        <div class="absolute inset-x-0 top-[-100dvh] bottom-[-100dvh]">
          <div class="sticky top-[60px] h-[calc(100dvh-60px)] w-full">
            <canvas id="escala-red" class="h-full w-full saturate-[0.3] brightness-[2.1] mix-blend-screen"></canvas>
          </div>
        </div>
      </div>

      <div class="relative mx-auto max-w-[760px]">
        <!-- El revelado va en la envoltura y no en el <h2>: el titulo tiene
             su propia animacion de opacidad (la brasa) y una animacion le
             gana a la transicion del revelado. -->
        <div data-titulo class="titulo-revelar">
          <h2 class="seccion-titulo seccion-titulo-claro text-[42px] font-mid leading-[1.08] tracking-[-0.025em] md:text-[56px] telefono:text-[30px]">
            El significado de esta pieza
          </h2>
        </div>
        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-white/85">
          El problema de la alimentación en México y su relación con la falta de idiosincrasia
          es algo que no estamos acostumbrados a escuchar, pero eso no significa que no se
          tenga que decir algo al respecto.
        </p>
        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-white/85">
          Durante años, como pueblo, nos hemos visto rezagados ante la indiferencia de nuestros
          gobernantes, y esa indiferencia ha comenzado a tocar puntos donde cosas
          indispensables para la sobrevivencia se han visto afectadas: el apoyo a otros
          sectores que solo buscan un bien económico ha comenzado a desplazar sigilosamente a
          toda la población, desde cosas bastante «simples» —como acceder a alimentos
          superprocesados de manera más rápida que a los alimentos que nos pertenecen como
          identidad de mexicanos y que han estado en nuestra civilización desde hace miles de
          años— hasta graves crímenes y atentados contra la población, como el desplazamiento
          de su lugar de origen o la afectación de su economía. Y no hablamos solo de una
          persona: hablamos de escalas más grandes, como las poblaciones que viven del sistema
          agroalimentario de la milpa.
        </p>
        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-white/85">
          Buscamos dar un llamado y que se visibilice todo esto que nos afecta: al final se
          está beneficiando a aquellos que solo buscan aprovecharse de nosotros, en vez de a
          aquellos que día con día levantamos a este país, mantenemos su cultura y vivimos con
          sus raíces.
          En esta pieza lo relatamos mediante la visualización de datos: todos los testimonios
          de un pueblo, ya sean trabajadores, transportistas, estudiantes, maestros,
          comerciantes, gente que se dedica a un oficio o una profesión. No se busca enfocarse
          en un solo sector: estamos hablando de toda una población, de todo un pueblo que día
          con día sostiene a este país y al que ni siquiera se le puede brindar una
          alimentación digna.
        </p>

        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-white/85">
          Nuestra visualización busca expresar este llamado de atención: que las personas
          puedan sentirse escuchadas, que tengan un espacio donde se les permita alzar la voz,
          aunque sea por un momento.
        </p>
      </div>
    </section>

    <!-- ========================= 03 · La historia de nuestros simbolos -->
    <!-- La puerta a `/historia`: lo que antes eran secciones seguidas de
         lectura en la portada —la visualizacion de datos, el mito y la
         milpa— aqui es un solo bloque que las anuncia y se las lleva. La
         portada se queda con el mural y con lo que lo explica; el relato
         esta a un clic.

         Las filas no son enlaces sueltos a cada ancla sino un indice de lo
         que hay al otro lado: el enlace es la tarjeta entera. El hover si es
         de cada fila (ver `.historia-fila:hover` en `mural.css`).

         El orden y los titulos son los de `PARTES` en
         `src/pages/historia.astro`: al anadir una seccion alla hay que
         anadir su fila aqui. -->
    <section id="historia" class="relative scroll-mt-[60px] border-t border-line/80 py-20 px-5 telefono:py-12 telefono:px-3.5">
      <div class="mx-auto max-w-[760px]">
        <!-- El revelado va en la envoltura y no en el <h2>: el titulo tiene
             su propia animacion de opacidad (la brasa) y una animacion le
             gana a la transicion del revelado. -->
        <div data-titulo class="titulo-revelar">
          <h2 class="seccion-titulo text-[42px] font-mid leading-[1.08] tracking-[-0.025em] md:text-[56px] telefono:text-[30px]">
            ¿Qué significa cada pieza del mural?
          </h2>
        </div>

        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-muted">
          La figura del mural no se hizo sin ningún motivo. Proviene de toda una serie de
          elementos que han acompañado nuestra cultura y que aún siguen vigentes en ciertos
          sectores de nuestro territorio; incluimos y nos inspiramos en elementos del México
          antiguo, piezas que nos han definido como mexicanos desde hace mucho tiempo. Toda esta
          inspiración se basó en relatos que nos dejaron nuestros antepasados, en una comida que
          lleva milenios sosteniendo a este pueblo y en el arte que pudo sobrevivir todas las
          tragedias que sufrió nuestro pueblo. Todo esto está contado por estos símbolos que no
          han dejado de marcarnos. Puedes encontrar el significado con más detalle aquí debajo.
        </p>

        <a
          href={`${BASE}historia`}
          data-revelar
          class="dieta-revelar historia-puerta mt-9 block no-underline"
        >
          <span class="historia-indice">
            <span class="historia-fila">
              <span class="historia-numero">01</span>
              <span class="historia-nombre">Visualización de datos</span>
              <span class="historia-pie">La herramienta: qué se está midiendo y por qué</span>
            </span>
            <span class="historia-fila">
              <span class="historia-numero">02</span>
              <span class="historia-nombre">Violencia alimentaria estructurada</span>
              <span class="historia-pie">El daño que se está midiendo</span>
            </span>
            <span class="historia-fila">
              <span class="historia-numero">03</span>
              <span class="historia-nombre">El mito de Quetzalcóatl</span>
              <span class="historia-pie">¿De dónde venimos nosotros?</span>
            </span>
            <span class="historia-fila">
              <span class="historia-numero">04</span>
              <span class="historia-nombre">La dieta de la milpa</span>
              <span class="historia-pie">Lo que sostiene a este territorio</span>
            </span>
            <span class="historia-fila">
              <span class="historia-numero">05</span>
              <span class="historia-nombre">Tlacuilo</span>
              <span class="historia-pie">El oficio: contar por imágenes y no por renglones</span>
            </span>
          </span>

          <span class="historia-entrar">
            Leer la historia de nuestros símbolos
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
      </div>
    </section>

    <!-- ================================================== 04 · El concepto -->
    <!-- La seccion es la mesa de referencias: las imagenes que estuvieron
         sobre la mesa antes del primer trazo, agrupadas por lo que cada tanda
         vino a resolver. Los grupos y sus pies salen de `CONCEPTO_GRUPOS`,
         arriba, y cierra con el parrafo del lienzo abierto. -->
    <section id="concepto" class="scroll-mt-[60px] border-t border-line/80 bg-paper/60 py-20 px-5 telefono:py-12 telefono:px-3.5">
      <div class="mx-auto max-w-[1120px]">
        <div class="flex flex-col gap-16 telefono:gap-12">
          {CONCEPTO_GRUPOS.map((grupo, i) => (
            <div>
              <div data-revelar class="dieta-revelar max-w-[720px]">
                <span class="concepto-numero">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 text-2xl font-mid leading-[1.2] tracking-[-0.02em] text-[#9e2b2b] telefono:text-xl">
                  {grupo.titulo}
                </h3>
                <p class="mt-2 text-md leading-[1.6] text-muted">{grupo.bajada}</p>
              </div>

              <div class="concepto-rejilla mt-8" data-columnas={grupo.piezas.length >= 3 ? '3' : '2'}>
                {grupo.piezas.map((pieza) => (
                  <figure data-revelar class="dieta-revelar concepto-figura">
                    <div class="concepto-marco">
                      {pieza.archivo ? (
                        <img
                          src={`${BASE}Conceptos/${pieza.archivo}`}
                          alt={pieza.alt}
                          width={pieza.ancho}
                          height={pieza.alto}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div
                          class="concepto-hueco"
                          style={`aspect-ratio: ${pieza.ancho} / ${pieza.alto}`}
                          aria-hidden="true"
                        />
                      )}
                    </div>
                    <figcaption class="concepto-pie">
                      <span class="concepto-pie-titulo">{pieza.titulo}</span>
                      <span class="concepto-pie-texto">{pieza.pie}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mx-auto mt-16 max-w-[760px] telefono:mt-12">
          <p data-revelar class="dieta-revelar text-lg leading-[1.7] text-muted">
            Por eso esto no es un cartel terminado ni una infografía: es un lienzo abierto que sigue
            creciendo mientras haya algo que nombrar.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================ 05 · Cómo participar -->
    <!-- La unica seccion en tarjetas: las cinco pantallas del registro van en
         `<details class="faq-item">`, cerradas salvo la primera, y cada una
         despliega lo que se pide y por que. El plegado es nativo del
         navegador, asi que no necesita nada del script del mural; `faq-item`
         (en `mural.css`) le pone el recuadro y el +/- del marcador. -->
    <section id="como-funciona" class="scroll-mt-[60px] border-t border-line/80 py-20 px-5 telefono:py-12 telefono:px-3.5">
      <div class="mx-auto max-w-[760px]">
        <!-- El revelado va en la envoltura y no en el <h2>: el titulo tiene
             su propia animacion de opacidad (la brasa) y una animacion le
             gana a la transicion del revelado. -->
        <div data-titulo class="titulo-revelar">
          <h2 class="seccion-titulo text-[42px] font-mid leading-[1.08] tracking-[-0.025em] md:text-[56px] telefono:text-[30px]">
            Cómo participar
          </h2>
        </div>

        <p data-revelar class="dieta-revelar mt-7 text-lg leading-[1.7] text-muted">
          Son cinco pantallas breves —casi todo se contesta con un toque— y el proceso está
          diseñado para completarse en menos de dos minutos, sin formularios largos ni pantallas
          complejas. Abre cada una para ver qué se pregunta y por qué.
        </p>

        <div class="mt-8 flex flex-col gap-3">
          <details data-revelar class="dieta-revelar faq-item" open>
            <summary>
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-2xs text-muted">01</span>
                ¿Cómo te llamas?
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-lg leading-[1.7] text-muted">
                Tu nombre y el estado de México del que eres son indispensables (solo se permiten
                ubicaciones de México); la edad y la ocupación son opcionales y solo acompañan tu
                ficha dentro del mural.
              </p>
            </div>
          </details>

          <details data-revelar class="dieta-revelar faq-item">
            <summary>
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-2xs text-muted">02</span>
                ¿Cómo te sientes con tu alimentación?
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-lg leading-[1.7] text-muted">
                Es la pregunta que decide tu color. En lugar de elegir en una lista fría, tocas
                directamente una de las nueve manchas de acuarela pintadas con el pincel del mural:
                las mismas de{' '}
                <a href="#escala" class="font-mid text-ink no-underline underline-offset-4 hover:underline">la escala de la alimentación</a>.
              </p>
            </div>
          </details>

          <details data-revelar class="dieta-revelar faq-item">
            <summary>
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-2xs text-muted">03</span>
                Qué prefieres comer, y si crees que mereces comer digno
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-lg leading-[1.7] text-muted">
                Dos preguntas de un toque: si prefieres comida completamente mexicana o algún
                producto superprocesado, y si crees que mereces una alimentación digna. No hay
                respuesta correcta —hay una respuesta tuya, y es la que cuenta.
              </p>
            </div>
          </details>

          <details data-revelar class="dieta-revelar faq-item">
            <summary>
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-2xs text-muted">04</span>
                Si es justo, y por qué se perdió
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-lg leading-[1.7] text-muted">
                Si te parece que las oportunidades alimenticias son justas para los mexicanos, y a
                quién le atribuyes que se hayan perdido los alimentos soberanos de México: a los
                gobernantes, a las cadenas grandes, o a que al pueblo ya no le interesan. Es la
                parte del registro que no se puede contar con un número.
              </p>
            </div>
          </details>

          <details data-revelar class="dieta-revelar faq-item">
            <summary>
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-2xs text-muted">05</span>
                ¿Qué te gustaría decir?
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-lg leading-[1.7] text-muted">
                Escribe un mensaje breve con tus propias palabras o toca una de las frases sugeridas
                según lo que contestaste en la escala. Al terminar, verás latir tu mancha en el
                dibujo.
              </p>
            </div>
          </details>
        </div>

        <button
          type="button"
          data-mural-action="registrar"
          class="glass-btn mt-8 cursor-pointer rounded-full px-5 py-2.5 text-sm font-mid"
        >
          Sumar mi mancha →
        </button>
      </div>
    </section>

    <!-- ===================================================== 06 · Referencias -->
    <!-- La ultima seccion: una ficha por fuente con su cita en APA, el
         enlace directo al texto y el boton que se lleva la cita al
         portapapeles, todas en una tira que se recorre de lado. Las citas y
         sus datos salen de `REFERENCIAS` (`src/data/referencias.ts`), de
         donde sale tambien el JSON-LD del final, asi que la pagina y los
         datos estructurados no se pueden desfasar. El plegado de la cursiva
         va por tramos: el titulo de la revista y su volumen son los unicos
         que la llevan.

         La investigacion propia es una fuente mas y entra en su lugar
         alfabetico; lo unico que la distingue es que su boton principal no
         sale del sitio. -->
    <section id="referencias" class="scroll-mt-[60px] border-t border-line/80 py-20 px-5 telefono:py-12 telefono:px-3.5">
      <div class="mx-auto max-w-[1120px]">
        <!-- El revelado va en la envoltura y no en el <h2>: el titulo tiene
             su propia animacion de opacidad (la brasa) y una animacion le
             gana a la transicion del revelado. -->
        <div class="max-w-[760px]">
          <div data-titulo class="titulo-revelar">
            <h2 class="seccion-titulo text-[42px] font-mid leading-[1.08] tracking-[-0.025em] md:text-[56px] telefono:text-[30px]">
              Referencias
            </h2>
          </div>

          <p data-revelar class="dieta-revelar mt-7 text-xl leading-[1.7] text-muted">
            Las investigaciones que sostienen lo que se cuenta aquí. Cada una va con su cita
            completa en APA (7.ª edición), el enlace directo al texto y el botón para copiar la
            cita tal cual: lo que se lee en esta página es obra de quien la firma.
          </p>

          <p data-revelar class="dieta-revelar ref-pista">
            {REFERENCIAS.length} referencias · desliza de lado para recorrerlas
          </p>
        </div>

        <!-- Las fichas no se apilan: van en una tira que se recorre de lado.
             El que se desplaza es el `div` y no la `<ul>`, para que la lista
             conserve sus roles; lleva `tabindex` y `role="region"` porque un
             contenedor desplazable tiene que poder recorrerse con el teclado
             (las flechas, una vez enfocado). -->
        <div
          class="ref-carrusel mt-9 telefono:mt-7"
          tabindex="0"
          role="region"
          aria-label="Referencias, tira que se desplaza de lado"
        >
          <ul class="ref-tira">
            {REFERENCIAS.map((ref) => (
              <li id={ref.id} data-revelar class="dieta-revelar glass-card ref-tarjeta">
                <p class="ref-cita">
                  {ref.cita.map((tramo) => (tramo.cursiva ? <em>{tramo.texto}</em> : tramo.texto))}{ref.url && (
                    <a
                      href={ref.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ref-doi"
                      aria-label={`${ref.url.startsWith('https://doi.org/') ? 'Abrir el DOI' : 'Abrir el enlace'} de ${ref.autorCorto} (${ref.anio})`}
                    >{ref.url}</a>
                  )}
                </p>

                <p class="ref-descripcion">{ref.descripcion}</p>

                <p class="ref-acceso">
                  <span class="ref-etiqueta">{ref.acceso}</span>{ref.notas.map((nota) => ` · ${nota}`)}
                </p>

                <!-- El boton principal lleva fuera del sitio salvo en la
                     investigacion propia, que no sale de esta pagina: ahi baja
                     a la seccion donde esta y no necesita `target` ni `rel`. -->
                <div class="ref-acciones">
                  {ref.url ? (
                    <a
                      href={ref.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ref-btn ref-btn-principal"
                      aria-label={`Leer ${ref.obra} de ${ref.autorCorto} (${ref.anio}) en ${ref.sede}`}
                    >
                      Leer la investigación
                    </a>
                  ) : ref.interno && (
                    <a
                      href={ref.interno.href}
                      class="ref-btn ref-btn-principal"
                      aria-label={`Ver la ${ref.obra} de ${ref.autorCorto} (${ref.anio}) en ${ref.interno.destino}`}
                    >
                      {ref.interno.etiqueta}
                    </a>
                  )}

                  {ref.pdf && (
                    <a
                      href={ref.pdf}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ref-btn"
                      aria-label={`Abrir el PDF del ${ref.obra} de ${ref.autorCorto} (${ref.anio})`}
                    >
                      PDF
                    </a>
                  )}

                  {ref.pagina && (
                    <a
                      href={ref.pagina}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ref-btn"
                      aria-label={`Abrir la página del ${ref.obra} de ${ref.autorCorto} (${ref.anio}) en ${ref.sede}`}
                    >
                      Página del artículo
                    </a>
                  )}

                  <!-- La cita en texto plano viaja en `data-cita` y la copia
                       `mural/citas.ts`, que ademas deja el boton en «Copiado ✓»
                       dos segundos. El aviso para lector de pantalla va en el
                       `role="status"` de al lado: el `aria-label` del boton tapa
                       el cambio de su propio rotulo. -->
                  <button
                    type="button"
                    data-cita={citaPlana(ref)}
                    class="ref-btn"
                    aria-label={`Copiar la cita de ${ref.autorCorto} (${ref.anio}) en formato APA`}
                  >
                    <span data-rotulo>Copiar cita</span>
                  </button>

                  <span data-estado-cita role="status" class="sr-only"></span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Datos estructurados de las fuentes (ver `REFERENCIAS_JSONLD`).
           Va `is:inline` para que Astro lo deje pasar tal cual y no lo trate
           como un modulo de JavaScript. -->
      <script type="application/ld+json" is:inline set:html={JSON.stringify(REFERENCIAS_JSONLD)} />
    </section>

  </main>

  <Footer pagina="inicio" />

  <script>
    import '../mural/main';
  </script>
</Base>
