---
/**
 * El esqueleto compartido. Solo la cascara: ninguna de las dos pantallas
 * renderiza contenido en el servidor, lo arma su script de cliente.
 */
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
