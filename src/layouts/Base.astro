---
/**
 * El esqueleto compartido de las dos rutas (`/` y `/historia`): el `<head>`,
 * el `<body>` y el arranque del revelado, que tiene que correr antes de que
 * el navegador pinte el primer parrafo.
 */
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /**
   * La imagen de la tarjeta cuando el link se comparte, relativa a `public/`.
   * Tiene que ser raster —1200x630 va bien—: ni WhatsApp ni Twitter rasterizan
   * un SVG, y los logos del proyecto son todos SVG.
   *
   * Por defecto, `og.jpg`: el mural con los registros de hoy y el nombre de la
   * pieza. No es una ilustracion aparte, es una captura de lo que hay en `/`,
   * asi que envejece con el mural; rehacerla es volver a capturarlo.
   */
  imagen?: string;
}

const { title, description, bodyClass, imagen = 'og.jpg' } = Astro.props;

const BASE = import.meta.env.BASE_URL;

/*
 * Las etiquetas de compartir necesitan URLs absolutas, y una URL absoluta sale
 * de `site` en `astro.config.mjs`. Si no esta puesto, `Astro.site` es
 * undefined: en vez de emitir un `canonical` roto o un `og:url` relativo —que
 * es peor que no tenerlos, porque los validadores los cuentan como error— no
 * se emite ninguna. El dia que `site` entre, aparecen las tres solas.
 */
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const portada = Astro.site && imagen ? new URL(`${BASE}${imagen}`, Astro.site).href : null;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />

    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mural Colectivo" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonica && <meta property="og:url" content={canonica} />}
    {portada && <meta property="og:image" content={portada} />}
    <meta name="twitter:card" content={portada ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {portada && <meta name="twitter:image" content={portada} />}
  </head>
  <body class={bodyClass}>
    <!-- El estado de partida del revelado se marca aqui, antes de que el
         navegador llegue al primer parrafo: si se dejara al script de la
         pagina (que es `type="module"` y corre al final) los textos
         asomarian un instante antes de esconderse. El respaldo de 4s lo
         quita si ese script no llega a arrancar, para que nada se quede
         invisible.

         Va en la cascara y no en cada ruta porque las dos revelan su texto
         igual —`initRevelados()` en `src/mural/pagina.ts`— y el momento en
         que esto corre es justo lo que hace que funcione. -->
    <script is:inline>
      document.documentElement.classList.add('revelar-activo');
      setTimeout(() => {
        if (!document.documentElement.dataset.revelarListo) {
          document.documentElement.classList.remove('revelar-activo');
        }
      }, 4000);
    </script>

    <slot />
  </body>
</html>
