# Si el mural se llena con el banco simulado de `tools/registros.mjs`.
#
# Se lee en el build, no en el navegador: cada despliegue se compila con su
# valor, asi que el codigo es identico en las tres ramas y la diferencia entre
# la pantalla de pruebas y la de produccion no vive en git.
#
#   true   -> entra el banco (desarrollo y la pantalla de pruebas)
#   todo lo demas, o ausente -> solo las personas reales (produccion)
#
# Apagado por defecto a proposito: que falte la variable tiene que dar un mural
# vacio, nunca mil ochocientas personas inventadas pasando por reales.
PUBLIC_DATOS_SIMULADOS=true

# Supabase (base de datos compartida y actualizaciones en tiempo real).
# Si se dejan vacias, el mural funciona solo con localStorage en este navegador.
# Usa SOLO la Publishable / anon key (nunca la secret / service_role key).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
